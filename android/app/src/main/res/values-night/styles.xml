<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode variant. The splash itself stays branded white so the
         logo always reads correctly against it; only NormalTheme adapts
         to the system dark theme behind the Flutter UI. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/waffer_splash_icon</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
